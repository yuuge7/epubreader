<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and transfer rules for API 31 and above.

  The two cases are deliberately different:

  cloud-backup   Index and settings only. The book files are not uploaded — see the
                 reasoning in backup_rules.xml.
  device-transfer Direct device-to-device migration never leaves the user's hands, so
                 the books and covers travel too and the new phone has a working
                 library instead of a list of entries pointing at missing files.

  The extraction cache is excluded everywhere; it is rebuilt from the EPUB on demand.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="books/" />
        <include domain="file" path="covers/" />
    </device-transfer>
</data-extraction-rules>
